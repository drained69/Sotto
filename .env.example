# Public template. Copy to .env.local, or set the same keys on the host.
# Every VITE_ value is baked into the browser bundle — never put private keys,
# paymaster secrets, manager keys, or authenticated RPC URLs here.

VITE_STRK20_NETWORK=mainnet
VITE_STARKNET_MAINNET_RPC_URL=https://rpc.starknet.lava.build
VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Required only when VITE_STRK20_NETWORK=sepolia. Official Sepolia tokens.
# Review: docs/sepolia-addresses.md
VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343

# Live Vesu lending is fail-closed: the UI hides the section unless BOTH a
# helper address AND a non-empty vault allowlist are set.
#
#   1. VITE_VESU_LENDING_HELPER_ADDRESS — Sotto helper for THIS network.
#      Mainnet: 0x06277c357edf60e9acbbd5a9efaeb8fcb0d0b0daf1f06801ed94d4247a9b1e6a
#      Sepolia: do not paste the Sepolia helper here while network=mainnet.
#               Use .env.sepolia / `npm run dev:sepolia` instead.
#   2. VITE_YIELD_VAULTS — vToken allowlist. Each entry REQUIRES: label,
#      underlying (a key of TOKENS), vTokenAddress, vTokenDecimals. Missing
#      or malformed entries are dropped silently.
#
# vTokenDecimals must be read from that vToken's own decimals() — it does NOT
# follow the underlying. Every Vesu v2 vToken verified on Mainnet reports 18,
# including vUSDC whose asset has 6. Getting this wrong misreports balances
# by 10^12, so there is deliberately no default.
#
# Re-verify vault addresses before enabling: `npm run mainnet:verify-addresses`.
# `npm run build:mainnet` bakes in the Prime STRK and Prime USDC vaults, so on
# Mainnet you only need to set VITE_VESU_LENDING_HELPER_ADDRESS after deploy.
VITE_VESU_LENDING_HELPER_ADDRESS=0x06277c357edf60e9acbbd5a9efaeb8fcb0d0b0daf1f06801ed94d4247a9b1e6a
VITE_YIELD_VAULTS={"vaults":[]}

# Privacy Bridge is intentionally a separate server-side integration. Do not
# add manager keys or paymaster credentials to a public Vite env file.

# --- Sepolia ---
# Preferred: `npm run dev:sepolia` / `npm run build:sepolia` (loads .env.sepolia).
# Or copy this block into .env.local and comment out the Mainnet values above.
# Published Sepolia vTokens wrap Vesu mock tokens, not official STRK / Circle
# USDC, so the vault list stays empty. Do not mix the mock-token profile from
# docs/sepolia-addresses.md with these official token addresses.
#
# VITE_STRK20_NETWORK=sepolia
# VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
# VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
# VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343
# VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
# VITE_YIELD_VAULTS={"vaults":[]}
