VITE_STRK20_NETWORK=mainnet
VITE_STARKNET_MAINNET_RPC_URL=https://rpc.starknet.lava.build
VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Required when VITE_STRK20_NETWORK=sepolia. Official Sepolia tokens only.
# Review: docs/sepolia-addresses.md
VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343

# Live Vesu lending is fail-closed: the UI hides the entire section unless
# BOTH a helper address AND a non-empty vault allowlist are set.
#
#   1. VITE_VESU_LENDING_HELPER_ADDRESS — Sotto's Vesu helper, per network.
#      Sepolia:  0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
#      Mainnet:  set after `sncast deploy` — see docs/deployment.md
#   2. VITE_VESU_VAULTS — vToken allowlist. Each entry REQUIRES: label,
#      underlying (a key of TOKENS), vTokenAddress, vTokenDecimals. Missing or
#      malformed entries are dropped silently.
#
# vTokenDecimals must be read from that vToken's own decimals() — it does NOT
# follow the underlying. Every Vesu v2 vToken verified on Mainnet reports 18,
# including vUSDC whose asset has 6. Getting this wrong misreports balances
# by 10^12, so there is deliberately no default.
#
# Re-verify vault addresses before enabling: `npm run mainnet:verify-addresses`.
#
# `npm run build:mainnet` bakes in the Prime STRK and Prime USDC vaults, so on
# Mainnet you only need to set VITE_VESU_LENDING_HELPER_ADDRESS. Sepolia keeps
# vaults empty here because published Sepolia vTokens wrap Vesu mock tokens,
# not the official STRK / Circle USDC the frontend spends.
VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
VITE_VESU_VAULTS={"vaults":[]}

# Privacy Bridge is intentionally a separate server-side integration. Do not
# add manager keys or paymaster credentials to a public Vite env file.

# --- Sepolia local profile ---
# VITE_STRK20_NETWORK=sepolia
# VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
# VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
# VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343
# VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
# VITE_VESU_VAULTS={"vaults":[]}
