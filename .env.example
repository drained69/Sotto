VITE_STRK20_NETWORK=mainnet
VITE_STARKNET_MAINNET_RPC_URL=https://rpc.starknet.lava.build
VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Required when VITE_STRK20_NETWORK=sepolia. Official Sepolia tokens only.
# Review: docs/sepolia-addresses.md
VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343

# Live Vesu lending is fail-closed until both the audited helper and the exact
# vToken vault addresses are set for the selected network. Sepolia helper is
# reviewed; vaults stay empty because published Vesu vTokens wrap mock tokens.
#
# Each vault entry REQUIRES: label, underlying (a key of TOKENS), vTokenAddress,
# and vTokenDecimals. A vault missing or malforming any of these is dropped.
#
# vTokenDecimals must be read from that vToken's own decimals() — it does NOT
# follow the underlying. Every Vesu v2 vToken verified on Mainnet 2026-08-17
# reports 18, including the vUSDC vaults whose asset has 6. Getting this wrong
# misreports balances by 10^12, so there is deliberately no default.
#
# Mainnet candidates pending two-person sign-off (docs/mainnet-addresses.md):
#   vSTRK Prime    0x06d6d2bf905dd199c78f2e421521d8473042737be9f47904e7578536c10f279d  STRK  18
#   vUSDC Prime    0x00387e8ddbb1ab36ca08874d9abc702ef4872ad600dcf76b7f240b71d7bc4e65  USDC  18
#
# Shape:
#   VITE_VESU_VAULTS={"vaults":[{"label":"Prime","underlying":"USDC","vTokenAddress":"0x…","vTokenDecimals":18}]}
VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
VITE_VESU_VAULTS={"vaults":[]}

# Privacy Bridge is intentionally a separate server-side integration. Do not
# add manager keys or paymaster credentials to a public Vite env file.

# --- Sepolia local profile ---
# VITE_STRK20_NETWORK=sepolia
# VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
# VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
# VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343
# VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
# VITE_VESU_VAULTS={"vaults":[]}
