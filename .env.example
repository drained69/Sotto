VITE_STRK20_NETWORK=mainnet
VITE_STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_8
VITE_STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_8

# Required when VITE_STRK20_NETWORK=sepolia. Never reuse mainnet token addresses.
VITE_SEPOLIA_STRK_ADDRESS=
VITE_SEPOLIA_USDC_ADDRESS=

# Live Vesu lending is fail-closed until both the audited helper and the exact
# vToken vault addresses are set for the selected network.
VITE_VESU_LENDING_HELPER_ADDRESS=
VITE_VESU_VAULTS={"vaults":[]}

# Privacy Bridge is intentionally a separate server-side integration. Do not
# add manager keys or paymaster credentials to a public Vite env file.
