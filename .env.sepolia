# Vite mode file for Starknet Sepolia.
# Loaded by `npm run dev:sepolia` / `npm run build:sepolia` (`vite --mode sepolia`).
# Independently reviewed 2026-08-17. See docs/sepolia-addresses.md.

VITE_STRK20_NETWORK=sepolia
VITE_STARKNET_MAINNET_RPC_URL=https://rpc.starknet.lava.build
VITE_STARKNET_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Official Sepolia tokens only. Do not substitute Vesu mock STRK/USDC here
# unless you also switch VITE_VESU_VAULTS to the matching mock-token profile
# in docs/sepolia-addresses.md.
VITE_SEPOLIA_STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
VITE_SEPOLIA_USDC_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343

# Helper class/address verified on Sepolia. Vaults stay empty: published Vesu
# vTokens wrap Vesu mock tokens, not official STRK / Circle USDC.
VITE_VESU_LENDING_HELPER_ADDRESS=0x03ef9a499a3be674f6b2af553adf2ab1d2d5fe130002e4e09113f5cfd1adc297
VITE_VESU_VAULTS={"vaults":[]}
